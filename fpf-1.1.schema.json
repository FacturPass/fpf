{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facturpass.fr/spec/fpf-1.1.schema.json",
  "title": "FacturPass Format (FPF) 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fpf", "kind", "legal", "einvoice"],
  "properties": {
    "fpf": { "const": "1.1" },
    "kind": { "const": "buyer" },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "name"],
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 — EN 16931 BT-55" },
        "name": { "type": "string", "minLength": 1, "description": "Legal name — EN 16931 BT-44" },
        "form": { "type": "string", "minLength": 1, "description": "Legal form (SAS, SARL...)" },
        "siren": { "type": "string", "pattern": "^[0-9]{9}$", "description": "FR company id — EN 16931 BT-47" },
        "siret": { "type": "string", "pattern": "^[0-9]{14}$", "description": "FR establishment id — no EN 16931 term of its own; addressing component of einvoice.address" },
        "vat": { "type": "string", "pattern": "^[A-Z]{2}[0-9A-Za-z]{2,12}$", "description": "VAT id — EN 16931 BT-48" }
      }
    },
    "einvoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eas", "address"],
      "properties": {
        "eas": { "type": "string", "pattern": "^[0-9]{4}$", "description": "EAS scheme code (0225 = FR) — EN 16931 BT-49-1" },
        "address": { "type": "string", "minLength": 1, "description": "Electronic address — EN 16931 BT-49" },
        "platform": { "type": "string", "minLength": 1, "description": "Receiving platform name (informative, volatile: resolved from the central directory, prefer omitting)" }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "zip": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "minLength": 1 },
        "buyerReference": { "type": "string", "minLength": 1, "description": "Buyer reference — EN 16931 BT-10" }
      }
    }
  }
}
